# ==============================================================================
# STREAMLIT SECRETS CONFIGURATION TEMPLATE (.streamlit/secrets.toml)
# Paste these key-value pairs into Streamlit Community Cloud Settings -> Secrets.
# ==============================================================================

# Remote / Hosted MySQL Server Credentials
MYSQL_HOST = "your-remote-mysql-host.example.com"
MYSQL_PORT = 3306
MYSQL_USER = "your_mysql_user"
MYSQL_PASSWORD = "your_mysql_password"

# Databases to monitor
DATABASES = ["row_data", "student_1_to_12"]

# Dashboard Passcode Gate: Protects your confidential records
DASHBOARD_PASSWORD = "Vishal@1426"

# PII Masking toggle (true/false)
MASK_PII = false
