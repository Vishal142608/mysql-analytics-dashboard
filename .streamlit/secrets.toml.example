# ==============================================================================
# STREAMLIT SECRETS CONFIGURATION TEMPLATE (.streamlit/secrets.toml)
# Copy this file to .streamlit/secrets.toml for local development,
# or paste these key-value pairs into Streamlit Community Cloud Settings -> Secrets.
# ==============================================================================

# Remote or Hosted MySQL Server Credentials
MYSQL_HOST = "your-remote-mysql-host.example.com"
MYSQL_PORT = 3306
MYSQL_USER = "analytics_user"
MYSQL_PASSWORD = "your_secure_password"

# Databases to monitor
DATABASES = ["row_data", "student_1_to_12"]

# Optional: Set a dashboard password to protect sensitive student & contact PII
# If left empty (""), the dashboard will be open to all viewers without login.
DASHBOARD_PASSWORD = "ChangeMeToYourSecretPIN"

# Optional: Set to true to mask phone numbers and emails on public view
MASK_PII = false
